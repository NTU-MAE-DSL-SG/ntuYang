<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="../styles.css?v=20260509-1142" rel="stylesheet"/>
<style>
      /* Photo-only hover link panel for people profile cards.
         The link panel is limited to the portrait/photo area so the text below stays visible. */
      .profile-hover-card {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        color: inherit;
        text-decoration: none;
      }

      .profile-hover-card .entity-card-media {
        position: relative;
        overflow: hidden;
      }

      .profile-hover-card .entity-card-media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: filter 180ms ease, transform 180ms ease;
      }

      .profile-hover-card:hover .entity-card-media img,
      .profile-hover-card:focus-within .entity-card-media img {
        filter: saturate(0.85) brightness(0.72);
        transform: scale(1.02);
      }

      .profile-hover-actions {
        position: absolute;
        inset: 0;
        z-index: 5;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 0.65rem;
        padding: 0.85rem;
        background: linear-gradient(135deg, rgba(10, 22, 40, 0.84), rgba(21, 54, 88, 0.72));
        opacity: 0;
        transform: translateY(10px);
        pointer-events: none;
        transition: opacity 180ms ease, transform 180ms ease;
      }

      .profile-hover-card:hover .profile-hover-actions,
      .profile-hover-card:focus-within .profile-hover-actions {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
      }

      .profile-hover-title {
        margin: 0;
        color: #ffffff;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        text-align: center;
      }

      .profile-hover-link-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.45rem;
      }

      .profile-hover-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2rem;
        border: 1px solid rgba(255, 255, 255, 0.55);
        border-radius: 999px;
        padding: 0.35rem 0.55rem;
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
        font-size: 0.78rem;
        font-weight: 700;
        text-decoration: none;
        backdrop-filter: blur(8px);
        transition: background 160ms ease, border-color 160ms ease, transform 160ms ease;
      }

      .profile-hover-link:hover,
      .profile-hover-link:focus-visible {
        background: rgba(255, 255, 255, 0.24);
        border-color: rgba(255, 255, 255, 0.9);
        transform: translateY(-1px);
        outline: none;
      }

      .profile-hover-card:focus-within {
        outline: 3px solid rgba(67, 139, 255, 0.45);
        outline-offset: 4px;
      }

      @media (hover: none) {
        .profile-hover-actions {
          position: static;
          opacity: 1;
          transform: none;
          pointer-events: auto;
          background: linear-gradient(135deg, rgba(18, 37, 66, 0.95), rgba(34, 75, 114, 0.95));
        }
      }
    </style>
</head>
